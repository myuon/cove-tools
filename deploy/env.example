# /home/ioijoi/cove-tools/env — the apps' secrets, read by systemd
# (EnvironmentFile=). Keep it mode 0600; install.sh creates it from this file
# with fresh random values the first time. Generate a value by hand with:
#
#   openssl rand -hex 32
#
# Changing a value takes a restart: sudo systemctl restart cove-tools

# The webhook lab's admin pages (apps/webhooks): `Authorization: Bearer
# <token>`, or the password of the browser's login prompt (any user name).
# The receive URLs need no secret: their unguessable id is the credential.
WEBHOOKS_ADMIN_TOKEN=change-me

# The bench ledger's posting secret (apps/ledger): `POST /ledger/api/runs`
# and `DELETE /ledger/api/runs/<id>` need `Authorization: Bearer <token>`.
LEDGER_TOKEN=change-me
