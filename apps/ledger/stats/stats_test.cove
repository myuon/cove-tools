test fn summarisesRepetitions() -> Result<Unit, Error> {
  let odd = spread([3.0, 1.0, 2.0]).unwrapOr(Spread(median: 0.0, least: 0.0, most: 0.0, count: 0))
  assertEqual(odd.median, 2.0)?
  assertEqual(odd.least, 1.0)?
  assertEqual(odd.most, 3.0)?
  assertEqual(odd.count, 3)?
  let even = spread([4.0, 1.0, 2.0, 3.0]).unwrapOr(odd)
  assertEqual(even.median, 2.5)?
  // Nothing measured is no spread at all, not a spread of zeros.
  assert(spread([]).isNone())?
  Ok(())
}

test fn writesNumbersForPeople() -> Result<Unit, Error> {
  assertEqual(show(113331.0), "113,331")?
  assertEqual(show(1234567.4), "1,234,567")?
  assertEqual(show(4.912), "4.91")?
  assertEqual(show(14.95), "14.9")?
  assertEqual(show(184.88), "185")?
  assertEqual(show(0.0405), "0.0405")?
  assertEqual(show(0.5), "0.5")?
  assertEqual(show(0.0), "0")?
  assertEqual(percent(0.1234), "+12.3%")?
  assertEqual(percent(-0.004), "-0.40%")?
  assertEqual(percent(2.5), "+250%")?
  Ok(())
}
