// What the ledger says about a set of repetitions — the median, the least
// and the most — and how it writes a number for people to read.

/// A metric's repetitions, summarised.
export struct Spread {
  median: Float
  least: Float
  most: Float
  /// How many repetitions there were. A spread of none is not built: an
  /// unmeasured metric is absent, not a spread of zero.
  count: Int
}

/// `values` summarised, or `None` when there are none.
export fn spread(values: Array<Float>) -> Option<Spread> {
  if values.length() == 0 {
    return None
  }
  let ordered = values.sorted(by: fn(a, b) { a < b })
  let count = ordered.length()
  let middle = count / 2
  let median = if count % 2 == 1 {
    ordered.get(middle).unwrapOr(0.0)
  } else {
    (ordered.get(middle - 1).unwrapOr(0.0) + ordered.get(middle).unwrapOr(0.0)) / 2.0
  }
  Some(
    Spread(
      median: median,
      least: ordered.get(0).unwrapOr(0.0),
      most: ordered.get(count - 1).unwrapOr(0.0),
      count: count,
    ),
  )
}

/// `value` with about three significant digits, and thousands separated:
/// `113,331`, `4.91`, `0.0405`. Whole numbers of four digits or more lose
/// nothing to rounding that a reader would see.
export fn show(value: Float) -> String {
  if value == 0.0 {
    return "0"
  }
  let size = value.abs()
  if size >= 1000.0 {
    return grouped(value.format(0))
  }
  // Places after the point that leave three significant digits.
  var places = 2
  var scale = size
  while scale < 1.0 && places < 12 {
    scale = scale * 10.0
    places += 1
  }
  if size >= 100.0 {
    places = 0
  } else if size >= 10.0 {
    places = 1
  }
  trimmed(value.format(places))
}

/// A relative difference as a signed percentage: `+12.3%`, `-0.4%`.
export fn percent(ratio: Float) -> String {
  let value = ratio * 100.0
  let size = value.abs()
  let text = if size >= 100.0 {
    grouped(value.format(0))
  } else if size >= 10.0 {
    value.format(1)
  } else {
    value.format(2)
  }
  if value > 0.0 { "+{text}%" } else { "{text}%" }
}

/// `digits` (an optional `-`, then digits) with a comma every three digits.
fn grouped(digits: String) -> String {
  let negative = digits.startsWith("-")
  let body = if negative { digits.slice(1, digits.length()) } else { digits }
  var parts = Vector.of()
  var end = body.length()
  while end > 3 {
    parts.push(body.slice(end - 3, end))
    end -= 3
  }
  parts.push(body.slice(0, end))
  var out = Vector.of()
  var at = parts.length() - 1
  while at >= 0 {
    out.push(parts.get(at).unwrapOr(""))
    at -= 1
  }
  let joined = ",".join(out.freeze())
  if negative { "-{joined}" } else { joined }
}

/// `text`, a fixed-point number, without the zeros after its point that say
/// nothing: `4.10` is `4.1` and `12.00` is `12`.
fn trimmed(text: String) -> String {
  if !text.contains(".") {
    return text
  }
  var end = text.length()
  while end > 0 && text.slice(end - 1, end) == "0" {
    end -= 1
  }
  if end > 0 && text.slice(end - 1, end) == "." {
    end -= 1
  }
  text.slice(0, end)
}
