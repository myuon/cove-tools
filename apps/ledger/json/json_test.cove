test fn anyTextSurvivesARoundTrip() -> Result<Unit, Error> {
  let control = String.fromCodePoint(1).unwrapOr("")
  let original = "quote \" backslash \\ newline \n tab \t ctl {control} é😀"
  let back = parse(render(Json.Text(original))).unwrapOr(Json.Null)
  assertEqual(back, Json.Text(original))?
  Ok(())
}

test fn readsUnicodeEscapes() -> Result<Unit, Error> {
  let value = parse("\"\\u00e9\\u3042 \\ud83d\\ude00\"").unwrapOr(Json.Null)
  assertEqual(value, Json.Text("éあ 😀"))?
  assert(parse("\"\\ud83d\"").isError())?
  Ok(())
}

test fn rendersIndented() -> Result<Unit, Error> {
  let value = parse("\{\"b\":[1,2],\"a\":\{\}\}").unwrapOr(Json.Null)
  assertEqual(renderPretty(value), "\{\n  \"a\": \{\},\n  \"b\": [\n    1,\n    2\n  ]\n\}")?
  Ok(())
}

test fn refusesAFieldNamedTwice() -> Result<Unit, Error> {
  assert(parse("\{\"p99\": 1, \"p99\": 2\}").isError())?
  assert(parse("\{\"a\": \{\"p99\": 1\}, \"p99\": 2\}").isOk())?
  Ok(())
}
