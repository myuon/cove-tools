use text

fn capabilities() -> Array<String> {
  Vector.of("admin", "auth", "kv", "log").freeze()
}

fn limitsForm() -> String {
  "fuel=1000&maxHostCalls=0&deadlineMs=500&maxHeapWords=0&maxInFlight=4&maxQueued=0&maxRequestBytes=10&maxResponseBytes=20"
}

test fn readsAConfigureForm() -> Result<Unit, Error> {
  let read = settingsFrom(
    text.parseForm("cap.kv=on&cap.log=on&allow=https%3A%2F%2Fa.example%0D%0A%0D%0A++http%3A%2F%2Fb.example%3A8080+&{limitsForm()}"),
    capabilities(),
  )
  assertEqual(read.problems.length(), 0)?
  assertEqual(",".join(read.settings.grant), "kv,log")?
  assertEqual(",".join(read.settings.fetchAllow), "https://a.example,http://b.example:8080")?
  assertEqual(read.settings.limits.fuel, 1000)?
  assertEqual(read.settings.limits.deadlineMs, 500)?
  assertEqual(read.settings.limits.maxInFlight, 4)?
  assertEqual(read.settings.limits.maxResponseBytes, 20)?
  Ok(())
}

test fn namesEveryProblemOfAForm() -> Result<Unit, Error> {
  let read = settingsFrom(
    text.parseForm("cap.teleport=on&allow=ftp%3A%2F%2Fx&fuel=0&maxHostCalls=-1&deadlineMs=soon&maxHeapWords=0&maxInFlight=0&maxQueued=0&maxRequestBytes=1&maxResponseBytes=1"),
    capabilities(),
  )
  let said = "\n".join(read.problems)
  assert(said.contains("`teleport` is not a capability"))?
  assert(said.contains("allowlist: `ftp://x`"))?
  assert(said.contains("fuel per request: 0 is less than 1"))?
  assert(said.contains("host calls per request: -1 is less than 0"))?
  assert(said.contains("deadline per request (ms): `soon` is not a whole number"))?
  assert(said.contains("runs in flight: 0 is less than 1"))?
  assertEqual(read.problems.length(), 6)?
  Ok(())
}

test fn escapesWhatItShows() -> Result<Unit, Error> {
  assertEqual(h("<script>alert('x')</script>"), "&lt;script&gt;alert(&#39;x&#39;)&lt;/script&gt;")?
  assert(badge("<b>").contains("&lt;b&gt;"))?
  assert(!problemsNotice(Vector.of("<img src=x>").freeze()).contains("<img"))?
  Ok(())
}
