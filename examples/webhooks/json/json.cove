// Adapted from the Cove repository's `examples/cq/json/json.cove` (MIT): the
// parser and the one-line renderer, with `\u` escapes read and written (the
// original refused them), every control character escaped on the way out,
// and an indented renderer for display.

/// Where in the text something went wrong, and what.
export struct Detail {
  column: Int
  message: String
}

/// A JSON value.
///
/// JSON has one number type, so this does too: an integer that arrived in the
/// input is a `Number` like any other, and a program that needs an `Int` asks
/// for one at the point where it knows that is what the field means. Putting
/// the distinction here instead would be inventing a JSON that the format does
/// not have.
export enum Json {
  Null
  Bool(Bool)
  Number(Float)
  Text(String)
  Items(Array<Json>)
  Fields(Map<String, Json>)
}

/// How deeply one value may nest before this parser refuses it.
///
/// The parser recurses through arrays and objects, so the depth of the input
/// decides the depth of the Cove call stack. A bound here is what keeps a
/// crafted line from ending the run inside the interpreter rather than in a
/// diagnostic this program wrote.
fn maxDepth() -> Int {
  64
}

/// Parses `text` as one complete JSON value.
///
/// The whole of `text` must be that value: trailing content is an error rather
/// than something the caller is left to notice, because a line of JSON Lines
/// that has more after the record is not a record with a comment on it.
export fn parse(text: String) -> Result<Json, Detail> {
  var scan = Scanner(text: text, at: 0, end: text.byteLength())
  scan.skipSpace()
  let value = parseValue(var scan, depth: 1)?
  scan.skipSpace()
  if !scan.done() {
    return Err(scan.fail("this line has more after the JSON value"))
  }
  Ok(value)
}

/// Renders `value` as JSON on one line, which is what a JSON Lines record is.
///
/// Object fields come out in `Map` order, which is ascending by key, so two
/// runs over the same input write the same bytes.
export fn render(value: Json) -> String {
  match value {
    Json.Null => "null"
    Json.Bool(yes) => "{yes}"
    Json.Number(number) => renderNumber(number)
    Json.Text(text) => quote(text)
    Json.Items(items) => {
      var parts = Vector.of()
      for item in items {
        parts.push(render(item))
      }
      "[{",".join(parts.freeze())}]"
    }
    Json.Fields(fields) => {
      var parts = Vector.of()
      for entry in fields {
        parts.push("{quote(entry.key)}:{render(entry.value)}")
      }
      "\{{",".join(parts.freeze())}\}"
    }
  }
}

/// The field `name` of an object, or `None` for anything else.
///
/// A value that is not an object has no fields rather than an empty set of
/// them, and both answer `None` here; a caller that needs to tell the two
/// apart matches on the value itself.
export fn field(value: Json, name: String) -> Option<Json> {
  match value {
    Json.Fields(fields) => fields.get(name)
    _ => None
  }
}

// ------------------------------------------------------------------ scanning

/// A position, as a byte offset, in the text being parsed.
///
/// `chars()` once stood between this parser and the input: it allocated an
/// `Array<String>` and one heap `String` per character before the first
/// comparison ran. Walking `text` by byte offset instead allocates nothing to
/// take a step, and a scalar (`Int`) is cheaper to compare than a `String` is.
struct Scanner {
  text: String
  at: Int
  end: Int // text.byteLength(), cached so the loop does not re-ask
}

impl Scanner {
  /// The scalar at the cursor, or `-1` when there is none left.
  ///
  /// `-1` is not a valid Unicode scalar value, so it is a safe stand-in for
  /// the end of the text in this `Int`-valued world, the same way `""` was a
  /// safe stand-in in the `String`-valued one: no character an input holds
  /// compares equal to it.
  fn peek(self) -> Int {
    self.text.codePointAtByte(self.at).unwrapOr(-1)
  }

  /// Whether every byte has been consumed.
  fn done(self) -> Bool {
    self.at >= self.end
  }

  /// Consumes one character, advancing by its width in bytes rather than by
  /// one.
  ///
  /// The width is written out here instead of behind a call to a `width`
  /// function: this runs once per character of every line this parser reads,
  /// and `examples/cq/README.md` measured a call at this spot as doubling the
  /// cost of a loop shaped just like this one.
  fn take(var self) {
    match self.text.codePointAtByte(self.at) {
      Some(codePoint) => {
        if codePoint < 128 {
          self.at += 1
        } else if codePoint < 2048 {
          self.at += 2
        } else if codePoint < 65536 {
          self.at += 3
        } else {
          self.at += 4
        }
      }
      None => {
        // Only reached if a caller takes past `done()`, which nothing here
        // does; advancing by one keeps this from looping forever if that
        // ever changes.
        self.at += 1
      }
    }
  }

  /// Consumes any run of JSON whitespace.
  fn skipSpace(var self) {
    while isSpace(self.peek()) {
      // Every JSON space character is one byte, so this advances directly
      // rather than asking `take` to look up a width it already knows.
      self.at += 1
    }
  }

  /// The 1-based character column of the byte offset `at`.
  ///
  /// `Detail.column` counts characters, not bytes, and `self.at` is a byte
  /// offset once multibyte input is in play, so answering a column means
  /// recounting the characters before it. That is O(`at`), but every caller
  /// of this is on an error path taken once per bad record, not once per
  /// character.
  fn columnAt(self, at: Int) -> Int {
    self.text.sliceBytes(0, at).unwrapOr("").length() + 1
  }

  /// An error at the cursor, whose column counts characters from 1.
  fn fail(self, message: String) -> Detail {
    Detail(column: self.columnAt(self.at), message: message)
  }

  /// Consumes `word` when it is next, and reports what was there when it is
  /// not.
  fn word(var self, word: String) -> Result<Unit, Error> {
    for expected in word.chars() {
      if self.peek() != expected.codePointAtByte(0).unwrapOr(-1) {
        return Err(Error("expected `{word}`"))
      }
      self.take()
    }
    Ok(())
  }
}

/// Whether `codePoint` is whitespace between JSON tokens.
fn isSpace(codePoint: Int) -> Bool {
  codePoint == ' ' || codePoint == '\t' || codePoint == '\r' ||
    codePoint == '\n'
}

// ------------------------------------------------------------------- parsing

/// Parses one value at `depth` levels of nesting.
fn parseValue(var scan: Scanner, depth: Int) -> Result<Json, Detail> {
  if depth > maxDepth() {
    return Err(scan.fail("this value nests more than {maxDepth()} levels deep"))
  }
  let head = scan.peek()
  if head == '{' {
    return parseObject(var scan, depth: depth)
  }
  if head == '[' {
    return parseArray(var scan, depth: depth)
  }
  if head == '"' {
    return Ok(Json.Text(parseText(var scan)?))
  }
  if head == 't' {
    scan.word("true").mapError(fn(error) {
      scan.fail("expected `true`")
    })?
    return Ok(Json.Bool(true))
  }
  if head == 'f' {
    scan.word("false").mapError(fn(error) {
      scan.fail("expected `false`")
    })?
    return Ok(Json.Bool(false))
  }
  if head == 'n' {
    scan.word("null").mapError(fn(error) {
      scan.fail("expected `null`")
    })?
    return Ok(Json.Null)
  }
  if head == -1 {
    return Err(scan.fail("a JSON value was expected and the line ended"))
  }
  if head == '-' || isDigit(head) {
    return parseNumber(var scan)
  }
  Err(scan.fail("`{scan.text.sliceBytes(scan.at, scan.at + width(head)).unwrapOr("")}` does not start a JSON value"))
}

/// Parses `{ ... }` at `depth` levels of nesting.
fn parseObject(var scan: Scanner, depth: Int) -> Result<Json, Detail> {
  scan.take()
  var fields = Map.of()
  scan.skipSpace()
  if scan.peek() == 125 {
    scan.take()
    return Ok(Json.Fields(fields))
  }
  var more = true
  while more {
    scan.skipSpace()
    if scan.peek() != 34 {
      return Err(scan.fail("a field name must be a quoted string"))
    }
    let name = parseText(var scan)?
    scan.skipSpace()
    if scan.peek() != 58 {
      return Err(scan.fail("a field name must be followed by `:`"))
    }
    scan.take()
    scan.skipSpace()
    let value = parseValue(var scan, depth: depth + 1)?
    fields = fields.inserted(name, value)
    scan.skipSpace()
    match scan.peek() {
      ',' => scan.take()
      '}' => {
        scan.take()
        more = false
      }
      _ => return Err(scan.fail("expected `,` or `\}` after a field"))
    }
  }
  Ok(Json.Fields(fields))
}

/// Parses `[ ... ]` at `depth` levels of nesting.
fn parseArray(var scan: Scanner, depth: Int) -> Result<Json, Detail> {
  scan.take()
  var items = Vector.of()
  scan.skipSpace()
  if scan.peek() == ']' {
    scan.take()
    return Ok(Json.Items(items.freeze()))
  }
  var more = true
  while more {
    scan.skipSpace()
    items.push(parseValue(var scan, depth: depth + 1)?)
    scan.skipSpace()
    match scan.peek() {
      ',' => scan.take()
      ']' => {
        scan.take()
        more = false
      }
      _ => return Err(scan.fail("expected `,` or `]` after an element"))
    }
  }
  Ok(Json.Items(items.freeze()))
}

/// Parses a quoted string, starting at the opening quote.
///
/// The text is taken with `sliceBytes` over the run between the opening quote
/// (or the previous escape) and whatever ends the current run, so the common
/// case -- a string with nothing to escape -- costs exactly one slice rather
/// than one interpolation per character. When an escape does appear, the run
/// so far is flushed with `sliceBytes(start, escapeAt)`, the unescaped
/// character is appended beside it, and a new run starts after the escape;
/// that is still one interpolation per escape rather than per character, and
/// escapes are the exception rather than the rule. A `Vector<String>` joined
/// once would also avoid the per-character cost, but a byte-offset run is
/// simpler still and needs no second collection.
fn parseText(var scan: Scanner) -> Result<String, Detail> {
  scan.take()
  var text = ""
  var start = scan.at
  var reading = true
  while reading {
    let character = scan.peek()
    if character == -1 {
      return Err(scan.fail("this string was never closed"))
    }
    if character < ' ' {
      return Err(scan.fail(
        "a string may not hold an unescaped control character",
      ))
    }
    if character == '"' {
      text = "{text}{scan.text.sliceBytes(start, scan.at).unwrapOr("")}"
      scan.take()
      reading = false
    } else if character == '\\' {
      let run = scan.text.sliceBytes(start, scan.at).unwrapOr("")
      scan.take()
      let unescaped = escape(var scan)?
      text = "{text}{run}{unescaped}"
      start = scan.at
    } else {
      scan.take()
    }
  }
  Ok(text)
}

/// Reads what follows a backslash inside a string.
fn escape(var scan: Scanner) -> Result<String, Detail> {
  let start = scan.at
  let character = scan.peek()
  scan.take()
  match character {
    '"' => Ok("\"")
    '\\' => Ok("\\")
    '/' => Ok("/")
    'n' => Ok("\n")
    't' => Ok("\t")
    'r' => Ok("\r")
    'u' => unicodeEscape(var scan)
    'b' => Ok(String.fromCodePoint(8).unwrapOr(""))
    'f' => Ok(String.fromCodePoint(12).unwrapOr(""))
    -1 => Err(scan.fail("a backslash ended the line"))
    _ => Err(scan.fail("`\\{scan.text.sliceBytes(start, start + width(character)).unwrapOr("")}` is not a JSON escape"))
  }
}

/// Parses a number, at a `-` or a digit.
///
/// The grammar is checked here rather than left to `Float.parse`, because the
/// two do not agree. `Float.parse` accepts `+1`, `01`, `.5`, and `1.`, and JSON
/// accepts none of the four; handing it the decision would mean reading each of
/// them as a number JSON never wrote, which is accepting bad input as a
/// different value rather than refusing it. So this walks
/// `[-] int [frac] [exp]` and `Float.parse` is left with text it has already
/// been told is a number.
///
/// The walk only advances `scan.at`; it does not build the matched text as it
/// goes. The whole number is one contiguous run of bytes, so it is taken with
/// a single `sliceBytes(start, scan.at)` once the grammar has been checked,
/// rather than reassembled from the pieces `digitsAt` would otherwise have had
/// to hand back one interpolation at a time.
fn parseNumber(var scan: Scanner) -> Result<Json, Detail> {
  let start = scan.at
  if scan.peek() == '-' {
    scan.take()
  }
  let leading = scan.peek()
  if !isDigit(leading) {
    return Err(scan.fail("a number needs a digit here"))
  }
  scan.take()
  if leading == '0' {
    if isDigit(scan.peek()) {
      return Err(scan.fail("a number may not have a leading zero"))
    }
  } else {
    digitsAt(var scan)
  }
  if scan.peek() == '.' {
    scan.take()
    if !isDigit(scan.peek()) {
      return Err(scan.fail("a decimal point needs a digit after it"))
    }
    digitsAt(var scan)
  }
  let exponent = scan.peek()
  if exponent == 'e' || exponent == 'E' {
    scan.take()
    if scan.peek() == '+' || scan.peek() == '-' {
      scan.take()
    }
    if !isDigit(scan.peek()) {
      return Err(scan.fail("an exponent needs a digit after it"))
    }
    digitsAt(var scan)
  }
  let text = scan.text.sliceBytes(start, scan.at).unwrapOr("")
  match Float.parse(text) {
    Ok(number) => {
      if isFinite(number) {
        Ok(Json.Number(number))
      } else {
        Err(Detail(column: scan.columnAt(start), message: "`{text}` is too large for a `Float` to hold"))
      }
    }
    Err(_) => Err(Detail(
      column: scan.columnAt(start),
      message: "`{text}` is not a number",
    ))
  }
}

/// Consumes the run of digits at the cursor, which may be empty.
///
/// The digits are not collected here: `parseNumber` slices the whole number
/// out of `scan.text` once, after the grammar has been checked, so this only
/// needs to move the cursor past them.
fn digitsAt(var scan: Scanner) {
  while isDigit(scan.peek()) {
    scan.take()
  }
}

/// Whether `value` is a real number rather than an infinity or `NaN`.
///
/// A grammatical number can still be one `Float` cannot hold: `1e999` parses
/// and answers `inf`, which is not a number any input meant. Cove has no
/// `isNaN` or `isInfinite`, so this asks both questions directly -- `NaN` is
/// the only value not equal to itself, and the only values past the largest
/// finite `Float` are the two infinities.
fn isFinite(value: Float) -> Bool {
  if value != value {
    return false
  }
  value <= 1.7976931348623157e308 && value >= -1.7976931348623157e308
}

/// Whether `codePoint` is one of `0` to `9`.
///
/// `-1`, this scanner's end-of-text sentinel, is answered `false` by the same
/// comparison that rejects any other non-digit; it needs no case of its own.
fn isDigit(codePoint: Int) -> Bool {
  codePoint >= '0' && codePoint <= '9'
}

/// The number of UTF-8 bytes the scalar `codePoint` occupies.
///
/// A `String` is valid UTF-8 in its shortest form, so the width is a function
/// of the value. `Scanner.take` needs this arithmetic on every character and
/// writes it out inline rather than calling here, because the call itself was
/// measured doubling that loop; the two error paths above call this instead,
/// since each runs at most once per bad record and the call costs nothing
/// there.
fn width(codePoint: Int) -> Int {
  if codePoint < 128 {
    1
  } else if codePoint < 2048 {
    2
  } else if codePoint < 65536 {
    3
  } else {
    4
  }
}

/// Renders a number the way JSON writes one.
///
/// A `Float` that is whole prints as `4.0` in Cove and has to print as `4` in
/// JSON, because a reader that takes `nights` as an integer should get one
/// back.
fn renderNumber(number: Float) -> String {
  match number.toInt() {
    Ok(whole) => {
      if whole.toFloat() == number {
        "{whole}"
      } else {
        "{number}"
      }
    }
    Err(_) => "{number}"
  }
}

/// Renders `text` as a quoted JSON string: `"`, `\` and every control
/// character escaped, so that any text survives a round trip.
fn quote(text: String) -> String {
  if !needsEscaping(text) {
    return "\"{text}\""
  }
  var parts = Vector.of()
  for character in text.chars() {
    match character {
      "\"" => parts.push("\\\"")
      "\\" => parts.push("\\\\")
      "\n" => parts.push("\\n")
      "\t" => parts.push("\\t")
      "\r" => parts.push("\\r")
      _ => {
        let point = character.codePointAtByte(0).unwrapOr(0)
        if point < 32 || point == 127 {
          parts.push("\\u{hex4(point)}")
        } else {
          parts.push(character)
        }
      }
    }
  }
  "\"{"".join(parts.freeze())}\""
}

/// Whether `text` holds anything a JSON string has to write as an escape.
fn needsEscaping(text: String) -> Bool {
  let end = text.byteLength()
  var at = 0
  while at < end {
    let byte = text.byteAt(at)
    if byte < 32 || byte == 34 || byte == 92 || byte == 127 {
      return true
    }
    at += 1
  }
  false
}

/// `point` as four lowercase hexadecimal digits.
fn hex4(point: Int) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  var shift = 12
  while shift >= 0 {
    let digit = point.shiftRight(shift).bitAnd(15)
    out = "{out}{digits.slice(digit, digit + 1)}"
    shift -= 4
  }
  out
}

/// Reads the four hexadecimal digits after `\u`, and a second `\uXXXX` when
/// the first is a high surrogate, into the character they name.
fn unicodeEscape(var scan: Scanner) -> Result<String, Detail> {
  let high = fourHex(var scan)?
  if high >= 55296 && high < 56320 {
    if scan.peek() != '\\' {
      return Err(scan.fail("a high surrogate must be followed by a low one"))
    }
    scan.take()
    if scan.peek() != 'u' {
      return Err(scan.fail("a high surrogate must be followed by a low one"))
    }
    scan.take()
    let low = fourHex(var scan)?
    if low < 56320 || low >= 57344 {
      return Err(scan.fail("a high surrogate must be followed by a low one"))
    }
    let point = 65536 + (high - 55296) * 1024 + (low - 56320)
    return String.fromCodePoint(point).mapError(fn(error) {
      scan.fail(error.message)
    })
  }
  String.fromCodePoint(high).mapError(fn(error) {
    scan.fail("`\\u{hex4(high)}` names no character")
  })
}

/// Four hexadecimal digits at the cursor, as a number.
fn fourHex(var scan: Scanner) -> Result<Int, Detail> {
  let start = scan.at
  if start + 4 > scan.end {
    return Err(scan.fail("`\\u` needs four hexadecimal digits"))
  }
  let digits = scan.text.sliceBytes(start, start + 4).unwrapOr("")
  match Int.parseRadix(digits, 16) {
    Ok(value) => {
      if value < 0 {
        return Err(scan.fail("`\\u` needs four hexadecimal digits"))
      }
      scan.at = start + 4
      Ok(value)
    }
    Err(_) => Err(scan.fail("`\\u` needs four hexadecimal digits"))
  }
}

/// Renders `value` as JSON over several lines, two spaces a level: what the
/// detail page shows a JSON body as.
export fn renderPretty(value: Json) -> String {
  pretty(value, "")
}

fn pretty(value: Json, indent: String) -> String {
  let inner = "{indent}  "
  match value {
    Json.Items(items) => {
      if items.length() == 0 {
        return "[]"
      }
      var parts = Vector.of()
      for item in items {
        parts.push("{inner}{pretty(item, inner)}")
      }
      "[\n{",\n".join(parts.freeze())}\n{indent}]"
    }
    Json.Fields(fields) => {
      if fields.isEmpty() {
        return "\{\}"
      }
      var parts = Vector.of()
      for entry in fields {
        parts.push("{inner}{quote(entry.key)}: {pretty(entry.value, inner)}")
      }
      "\{\n{",\n".join(parts.freeze())}\n{indent}\}"
    }
    other => render(other)
  }
}

/// The text field `name` of an object, or `""`.
export fn text(value: Json, name: String) -> String {
  match field(value, name) {
    Some(Json.Text(text)) => text
    _ => ""
  }
}

/// The number field `name` of an object as an `Int`, or `fallback`.
export fn int(value: Json, name: String, fallback: Int) -> Int {
  match field(value, name) {
    Some(Json.Number(number)) => number.toInt().unwrapOr(fallback)
    _ => fallback
  }
}

/// The boolean field `name` of an object, or `fallback`.
export fn bool(value: Json, name: String, fallback: Bool) -> Bool {
  match field(value, name) {
    Some(Json.Bool(yes)) => yes
    _ => fallback
  }
}

/// The object field `name` as a map of its text fields, or an empty map.
export fn textMap(value: Json, name: String) -> Map<String, String> {
  var out: Map<String, String> = Map.of()
  match field(value, name) {
    Some(Json.Fields(fields)) => {
      for entry in fields {
        match entry.value {
          Json.Text(text) => {
            out = out.inserted(entry.key, text)
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  out
}

/// A map of text as a JSON object.
export fn fromTextMap(entries: Map<String, String>) -> Json {
  var fields: Map<String, Json> = Map.of()
  for entry in entries {
    fields = fields.inserted(entry.key, Json.Text(entry.value))
  }
  Json.Fields(fields)
}
